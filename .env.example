# Reality Dreams CRM — required environment variables.
# These are the ONLY variables the app needs. Both are public (client-side) values:
# the publishable anon key is safe to expose; Row Level Security protects the data.
# The service-role key and the form intake secret are NEVER used by this app —
# they stay server-side inside Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
